{
  "buildCommand": "cd JobNexAI/frontend && CI=false npm run build",
  "outputDirectory": "JobNexAI/frontend/build",
  "installCommand": "cd JobNexAI/frontend && npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
